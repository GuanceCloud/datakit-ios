{
  "name": "@cloudcare/guance-electron-adapter",
  "version": "0.1.0",
  "description": "JavaScript-only Guance Electron adapter for a Native-owned macOS SDK",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/src/main/index.js",
  "types": "dist/src/main/index.d.ts",
  "files": [
    "dist/src",
    "dist/preload.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./preload": {
      "types": "./dist/src/preload/index.d.ts",
      "default": "./dist/preload.js"
    },
    "./internal": {
      "types": "./dist/src/main/internal.d.ts",
      "default": "./dist/src/main/internal.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-preload.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=16.17"
  },
  "os": [
    "darwin"
  ]
}
