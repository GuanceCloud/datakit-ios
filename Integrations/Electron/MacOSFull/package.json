{
  "name": "@cloudcare/guance-electron-macos",
  "version": "0.1.0",
  "description": "Full Mode Guance Native SDK and WebView bridge for Electron on macOS",
  "license": "Apache-2.0",
  "type": "commonjs",
  "gypfile": false,
  "main": "dist/src/main/index.js",
  "types": "dist/src/main/index.d.ts",
  "files": [
    "dist/src",
    "dist/preload.js",
    "adapter",
    "native",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/main/index.d.ts",
      "default": "./dist/src/main/index.js"
    },
    "./preload": {
      "types": "./dist/src/preload/index.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-adapter-preload.mjs",
    "test": "node --test dist/test/*.test.js",
    "test:native-addon": "npm run build:native -- --debug && npm run build && node scripts/test-native-addon.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:universal": "node scripts/build-universal.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=16.17"
  },
  "os": [
    "darwin"
  ]
}
